# =====================================================================
# LabMango Router (tenant resolver) configuration. Copy this file to .env and edit it.
# After a change run:  docker compose up -d   (the containers are recreated with the new values)
# =====================================================================

# ---- Admin account (page /admin/ and API /api/v1/admin/*) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- Database ----
# Local: the "postgres" service of docker-compose.yml (docker compose --profile db up), with the POSTGRES_* values below.
# Production: your PostgreSQL server (it can be the database of the old Django service; its data is reused).
DATABASE_URL=postgres://tenant:tenant@postgres:5432/tenant_resolver
POSTGRES_USER=tenant
POSTGRES_PASSWORD=tenant
POSTGRES_DB=tenant_resolver

# ---- Azure AD / Entra ID (validation of the users' ID tokens) ----
# AAD_AUDIENCE must be the frontend's application (client) ID: VITE_CLIENT_ID of the frontend.
AAD_AUDIENCE=eb57f92a-fe50-46b7-b0d8-775cb6b9bdc6
AAD_JWKS_URL=https://login.microsoftonline.com/0ae51e19-07c8-4e4b-bb6d-648ee58410f4/discovery/v2.0/keys
# Outbound proxy if the corporate network requires one (only used for Microsoft endpoints, never for the sync):
# HTTPS_PROXY=http://proxy.example:8080

# ---- Frontend ----
# Browser origins of the frontend allowed by nginx CORS (comma separated). Must contain the frontend origin
# when the frontend runs with VITE_API_MODE=router.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# A user or agent claimed by more than one backend: reject (409, default, as the backend spec requires) or
# all (return every backend, the old Django behaviour).
# ROUTING_CONFLICT_POLICY=reject

# ---- Routing sync with the backends (GET /internal/* of each backend) ----
# Through the internal nginx listener (port 8080, never published).
NGINX_INTERNAL_BASE_URL=http://nginx:8080
NGINX_INTERNAL_HOST_HEADER=localhost
BACKEND_SYNC_CONNECT_TIMEOUT=5
# Must be at least SYNC_LONGPOLL_WAIT + 10 seconds.
BACKEND_SYNC_READ_TIMEOUT=60
# Long-poll wait of /internal/changes (seconds, 0..30).
SYNC_LONGPOLL_WAIT=30

# Sync credential, see docs/DEPLOYMENT.md section 5:
#   static : bearer token (Method B). The backend lists sha256(token) in ROUTING_SYNC_STATIC_TOKEN_HASHES.
#   entra  : Entra application token (Method A), one audience per backend (api://labmango-<backend_id>).
ROUTING_SYNC_AUTH=static
# One token for every backend (or ROUTING_SYNC_TOKEN_FILE=/run/secrets/routing_sync_token) ...
ROUTING_SYNC_TOKEN=
# ... and/or one token per backend: files <dir>/<prefix_key> or <dir>/<backend_id> (recommended).
# ROUTING_SYNC_TOKENS_DIR=/run/secrets/sync-tokens
# Method A only:
# ROUTING_SYNC_ENTRA_TENANT_ID=
# ROUTING_SYNC_CLIENT_ID=
# ROUTING_SYNC_CLIENT_SECRET_FILE=/run/secrets/routing_sync_client_secret
# ROUTING_SYNC_SCOPE_TEMPLATE=api://labmango-{backend_id}/.default

# On/off switch of the sync. When on, the leader replica runs the continuous long-poll loops (users + agents of
# every active backend) and the scheduler. The hourly sync_all_backend_* jobs are only a safety net (drift => resync).
SYNC_ENABLED=true
# Only one replica syncs (PostgreSQL advisory lock). Disable only for a single replica without lock support.
# LEADER_ELECTION=true
# Only used on the very first start, when the database has no schedule yet (and no old Celery beat schedule):
USER_SYNC_INTERVAL=3600
AGENT_SYNC_INTERVAL=3600

# ---- Nginx map ----
# Already set in docker-compose*.yml; change only when running outside Docker:
# NGINX_MAP_FILE=/nginx-tenants/backends.map   # git-managed map (read-only)
# NGINX_ADMIN_DIR=/nginx-admin                  # directory shared with nginx (generated map)

# ---- Other options ----
# HOST_PORT=8080              # public port of the local nginx
# DB_MAX_CONNECTIONS=20
# AAD_JWKS_CACHE_TTL=3600
# RUST_LOG=info               # e.g. info,tower_http=debug to log every request
# LOG_FORMAT=json
