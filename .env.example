# LabMango Router configuration. Copy to .env and edit.
# After a change: docker compose -f docker-compose.<dev|prod>.yml up -d   (containers are recreated)

# ---- Admin account (page /admin/, API /admin/api/*) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- Database ----
# Production: your PostgreSQL server. Development: docker-compose.dev.yml runs PostgreSQL and builds
# DATABASE_URL from the POSTGRES_* values itself.
DATABASE_URL=postgres://router:router@db.example.internal:5432/router
POSTGRES_USER=router
POSTGRES_PASSWORD=router
POSTGRES_DB=router

# ---- Microsoft Entra ID (users' ID tokens) ----
# Tenant of the users, and the frontend's application (client) ID: VITE_TENANT_ID and VITE_CLIENT_ID of the frontend.
AAD_TENANT_ID=00000000-0000-0000-0000-000000000000
AAD_AUDIENCE=00000000-0000-0000-0000-000000000000
# Signing keys; derived from AAD_TENANT_ID when not set.
# AAD_JWKS_URL=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
# Outbound proxy for Microsoft endpoints only (never used for the backend sync):
# HTTPS_PROXY=http://proxy.example:8080

# ---- Frontend ----
# The frontend's own nginx normally proxies /routing/ and /t/ to the Router (same origin, no CORS). Only when the
# browser calls the Router from another origin, list that origin here (comma separated).
CORS_ALLOWED_ORIGINS=

# ---- Routing sync with the backends (GET /internal/* through nginx port 8080) ----
# static : bearer token; each backend lists sha256(token) in ROUTING_SYNC_STATIC_TOKEN_HASHES.
# entra  : Entra application token, one audience per backend (api://labmango-<backend_id>).
ROUTING_SYNC_AUTH=static
# One token for every backend (or ROUTING_SYNC_TOKEN_FILE=/run/secrets/routing_sync_token) ...
ROUTING_SYNC_TOKEN=
# ... and/or one token per backend: files <dir>/<prefix_key> or <dir>/<backend_id> (recommended).
# ROUTING_SYNC_TOKENS_DIR=/run/secrets/sync-tokens
# entra only:
# ROUTING_SYNC_ENTRA_TENANT_ID=
# ROUTING_SYNC_CLIENT_ID=
# ROUTING_SYNC_CLIENT_SECRET_FILE=/run/secrets/routing_sync_client_secret
# ROUTING_SYNC_SCOPE_TEMPLATE=api://labmango-{backend_id}/.default

# Long-poll wait of /internal/changes (seconds, 0..30); the read timeout must be at least wait + 10.
SYNC_LONGPOLL_WAIT=30
BACKEND_SYNC_CONNECT_TIMEOUT=5
BACKEND_SYNC_READ_TIMEOUT=60
# Stream sync and scheduler on/off (the leader replica runs them).
SYNC_ENABLED=true
# Interval (seconds) of the check_*_stream jobs when their schedule is first created; edit it later on /admin/.
SYNC_CHECK_INTERVAL=3600
# Only one replica syncs (PostgreSQL advisory lock).
# LEADER_ELECTION=true

# ---- Other options ----
# HOST_PORT=8080              # public port of the development nginx
# DB_MAX_CONNECTIONS=20
# AAD_JWKS_CACHE_TTL=3600
# RUST_LOG=info               # e.g. info,tower_http=debug logs every request with its x-request-id
# LOG_FORMAT=json             # default in docker-compose.prod.yml
